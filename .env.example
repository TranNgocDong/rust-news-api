SERVER_HOST=127.0.0.1
SERVER_PORT=8081

# PostgreSQL: thay YOUR_PASSWORD bằng mật khẩu thật
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/news_api

# Chuỗi bí mật ký JWT, tối thiểu 32 ký tự
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS

# Thư mục lưu file upload
UPLOAD_DIR=uploads

# Kích thước tối đa mỗi file: 2 MB
MAX_UPLOAD_BYTES=2097152